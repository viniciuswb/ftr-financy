{
  "name": "financy-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "description": "Financy GraphQL API",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "class-validator": "0.15.1",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "graphql": "16.14.2",
    "graphql-scalars": "1.26.0",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "type-graphql": "2.0.0-rc.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
